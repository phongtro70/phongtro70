# KHÔNG điền giá trị thật vào file này. Giá trị thật nhập trên Vercel > Settings > Environment Variables.
APP_PASSWORD=
SESSION_SECRET=
# Các biến dưới đây Vercel TỰ THÊM khi bạn kết nối Upstash Redis và Vercel Blob (Storage):
# KV_REST_API_URL=  KV_REST_API_TOKEN=   (hoặc UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
# BLOB_READ_WRITE_TOKEN=
# Tùy chọn: DB_DRIVER=redis|blob|github  STORAGE_LIMIT_MB=1024
# Tùy chọn khác:
# SESSION_IDLE_MINUTES=5   (số phút không thao tác thì phải đăng nhập lại)
# GOOGLE_SHEET_WEBHOOK_URL=  GOOGLE_SHEET_SECRET=   (sao lưu Google Sheet, xem docs/GOOGLE-SHEET.md)
# UPSTASH_COMMAND_LIMIT=500000  UPSTASH_DB_LIMIT_MB=256
# APP_PASSWORD_HASH=   (nâng cao: thay APP_PASSWORD bằng mã băm scrypt, tạo bằng scripts/hash-password.js)
# Chỉ khi dùng GitHub làm nơi lưu (DB_DRIVER=github): GITHUB_TOKEN GITHUB_OWNER GITHUB_REPO GITHUB_BRANCH GITHUB_DB_PATH
# SHEETS_SYNC=1   (chỉ dùng khi kiểm thử: bắt buộc chờ Google Sheet ghi xong rồi mới trả lời; bình thường để trống để lưu nhanh)
# VERCEL           (Vercel tự đặt; mã dùng để biết đang chạy trên Vercel hay trên máy chủ chạy liên tục như Render)
# BLOB_STORE_ID + VERCEL_OIDC_TOKEN   (Vercel tự đặt khi nối kho Blob kiểu mới OIDC; khi đó KHÔNG cần BLOB_READ_WRITE_TOKEN)
